SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
# Docker compose maps Postgres to host port 5433 (5432 is often already taken).
# DATABASE_URL=postgres://lavenderhill:change-me@127.0.0.1:5433/lavenderhill
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
FREE_SHIPPING_THRESHOLD=50
DEFAULT_CURRENCY=GBP
EXPRESS_SHIPPING_FEE=6.95
STANDARD_SHIPPING_FEE=3.95
TAX_RATE=0
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# What runserver does to the DB on boot:
#   0 = never seed
#   1 = wipe + re-seed the demo data on every start (re-runs on each autoreload)
#   2 = seed only if the catalogue is empty
#   3 = wipe all data, keep/create the staff login only (no demo data)
SEED_DEMO=1
